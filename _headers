# Security headers for all routes (served by Netlify).
# CSP notes:
#  - No 'unsafe-eval' and no 'unsafe-inline' in script-src: the page runs only
#    script files (its own, and PayPal's on the donate page). Plotly is the
#    "strict" build, made for such a policy.
#  - PayPal needs *.paypal.com / *.paypalobjects.com / venmo across script,
#    frame, connect and img. Style is 'unsafe-inline' (Plotly + PayPal inject
#    inline styles; low risk).
#  - The "Suggérer un test" form POSTs to a Google Apps Script web app.
#  - Fonts are self-hosted (fonts/): no Google Fonts request, nothing sent to a third party.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), camera=(), microphone=(), usb=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: default-src 'self'; script-src 'self' https://*.paypal.com https://*.paypalobjects.com https://www.venmo.com; style-src 'self' 'unsafe-inline' https://*.paypal.com; font-src 'self' data:; img-src 'self' data: blob: https://*.paypal.com https://*.paypalobjects.com; connect-src 'self' https://script.google.com https://script.googleusercontent.com https://*.paypal.com https://*.paypalobjects.com https://www.venmo.com; frame-src https://*.paypal.com https://*.paypalobjects.com https://www.venmo.com; child-src https://*.paypal.com https://*.paypalobjects.com https://www.venmo.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
